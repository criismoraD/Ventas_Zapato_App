# ============================================================
# SENATI_ZAPATO — Variables de entorno (NO subir a git)
# Copia este archivo como ".env" y pega tu key real.
# Consigue tu key gratis en: https://aistudio.google.com/apikey
# Tambien puedes pegar la key desde el modulo Config dentro de la app.
# ============================================================
GEMINI_API_KEY=PEGA_AQUI_TU_API_KEY_DE_GEMINI
# Principal chat: Gemini 3.5 Flash Lite. Secundarios: Gemma 4 26B y 31B.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODELS=gemini-3.5-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
# Voz Live principal: Gemini 3.8 Live (fallback automatico a 3.1 si no esta habilitado).
GEMINI_LIVE_MODEL=models/gemini-3.8-live
# Thinking: MINIMAL, LOW, MEDIUM, HIGH. MINIMAL reduce la espera en conversaciones normales.
GEMINI_THINKING=MINIMAL
# Busqueda web con Google Search grounding: true/false.
GEMINI_SEARCH=false
